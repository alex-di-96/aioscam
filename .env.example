# AioScam v0.1.8 — Configuration Template
# Copy to .env and fill in your values

# Bot token (required) — get it from @MaxBot
MAX_BOT_TOKEN=your_token_here

# Environment mode: debug | test | prod  (default: prod)
# debug — full logging with file:line info
# test  — warnings and errors only
# prod  — errors only
AIOSCAM_ENV=prod

# Max API base URL (optional, default shown)
# AIOSCAM_API_URL=https://platform-api.max.ru
